---
import { Image } from "astro:assets";
import logo from "../assets/khor-logo.png";
import brand from "../config/brand.json";
---

<footer
  class="mt-10 border-t border-hairline px-5 pt-14 pb-12 text-center sm:px-7 sm:pt-[70px] sm:pb-[60px]"
>
  <Image
    src={logo}
    alt={brand.name}
    width={144}
    height={144}
    class="mx-auto mb-4 size-[72px] rounded-full"
    loading="lazy"
  />
  <div class="font-ar text-[28px] font-extrabold">{brand.name}</div>
  <div class="mt-2.5 font-lat text-sm tracking-[1px] text-cream/50" dir="ltr">
    {brand.copyright}
  </div>
</footer>
