---
// Inline Lucide-style glyphs, traced from the design. Inline SVG per PRD §3 — no icon font.
interface Props {
  name: "pin" | "clock" | "phone" | "whatsapp" | "instagram";
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "pin" && (
      <Fragment>
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </Fragment>
    )
  }
  {
    name === "clock" && (
      <Fragment>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </Fragment>
    )
  }
  {
    name === "phone" && (
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
    )
  }
  {
    name === "whatsapp" && (
      <path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.7A8.4 8.4 0 1 1 21 11.5Z" />
    )
  }
  {
    name === "instagram" && (
      <Fragment>
        <rect x="2" y="2" width="20" height="20" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" />
      </Fragment>
    )
  }
</svg>
